# Analítica (PostHog) — opcional pero recomendado.
# 1. Creá una cuenta gratis en https://posthog.com y un proyecto.
# 2. Copiá la "Project API Key" (empieza con phc_...). Es una clave pública de cliente.
# 3. En Netlify: Site settings > Environment variables, agregá estas dos.
#    (Localmente podés crear un archivo .env.local con estos valores.)
#
# Si estas variables no están definidas, el sitio funciona igual sin analítica.

NEXT_PUBLIC_POSTHOG_KEY=phc_tu_clave_de_proyecto
# Región del proyecto: EE.UU. = https://us.i.posthog.com  |  UE = https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
